# API Keys for AI Video Generation Pipeline (Free Tiers)

# 1. Google AI Studio (Gemini 3.8 Flash & Gemini TTS) - Free
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cloudflare Workers AI (FLUX.1 schnell / FLUX.2 klein) - Free tier
# Get token from: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# 3. Optional: Kaggle API for remote Wan 2.2 / ACE-Step batch jobs
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
